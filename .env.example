# One gateway key can route both model families.
AI_GATEWAY_API_KEY=

# Or connect providers directly.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Required when enabling remote coding-agent sandboxes.
VERCEL_OIDC_TOKEN=

# Alternative sandbox credentials: set all three together on the server.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
