# One gateway key can route both model families.
AI_GATEWAY_API_KEY=

# Or connect providers directly.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Required when enabling remote coding-agent sandboxes.
VERCEL_OIDC_TOKEN=

# Alternative sandbox credentials: set all three together on the server.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Access control. Production refuses runs until an access token is set
# (or COLLABORAGENT_ALLOW_ANONYMOUS=true is set deliberately).
COLLABORAGENT_ACCESS_TOKEN=
COLLABORAGENT_ALLOW_ANONYMOUS=
# Per-instance limits (defaults shown).
COLLABORAGENT_RUNS_PER_HOUR=20
COLLABORAGENT_HARNESS_RUNS_PER_HOUR=4
COLLABORAGENT_MAX_CONCURRENT_RUNS=4

# Optional AI Gateway model overrides per role (defaults in lib/models.ts).
COLLABORAGENT_MODEL_ARCHITECT=
COLLABORAGENT_MODEL_RESEARCHER=
COLLABORAGENT_MODEL_BUILDER=
COLLABORAGENT_MODEL_REVIEWER=
